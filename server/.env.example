# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
# Set to your local MongoDB or Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/preppilot

# JWT Secret & Expiration
JWT_SECRET=preppilot_super_secret_jwt_key_for_college_project_2026
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
# If empty or invalid, the app safely falls back to realistic mock AI evaluation for viva/offline demos!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
