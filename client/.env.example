# Backend REST API base URL
# For local development with Vite proxy: leave empty or set to /api or http://localhost:5001/api
# For production (e.g. GitHub Pages frontend talking to Render backend):
# Set this to your Render service URL, e.g. https://your-backend.onrender.com/api
VITE_API_URL=https://your-render-backend-url.onrender.com/api
